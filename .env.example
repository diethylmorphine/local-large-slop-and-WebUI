# Local GGUF model. It is downloaded on first chat use if not present.
MODEL_REPO_ID=Qwen/Qwen2.5-3B-Instruct-GGUF
MODEL_FILENAME=qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf

# The supported CPU profile uses exactly four threads and a 4096-token context.
N_THREADS=4
N_CTX=4096

# Bind to all interfaces for hosting.
HOST=0.0.0.0
PORT=25666

# Optional Hugging Face token for gated/private repositories.
# HF_TOKEN=
